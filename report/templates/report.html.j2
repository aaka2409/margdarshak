{#- Margdarshak yearly report.  One document; fixed pages are written out here,
    running text is wrapped in <section class="flow"> and paginated by paginate.js. -#}
{%- set S = static -%}
{%- set who = person.name ~ " · " -%}

{%- macro footer() -%}
<div class="footer">
  <div class="who">Astro Diva · <span class="deva">{{ title_hi }}</span> {{ year }}</div>
  <div class="folio"></div>
</div>
{%- endmacro -%}

{%- macro running(text) -%}
<div class="running"><span class="txt">{{ text }}</span></div>
{%- endmacro -%}

{%- macro sec_head(num, eyebrow, title_lines, emblem) -%}
<div class="sec-head">
  <div class="row">
    {% if num %}<div class="num">{{ num }}</div>{% endif %}
    <div class="titles">
      <div class="eyebrow">{{ eyebrow }}</div>
      <h1>{{ title_lines|join(" ") }}</h1>
    </div>
  </div>
  <div class="hr"></div>
</div>
{%- endmacro -%}

{%- macro emblem_img(path) -%}<img src="{{ S }}/svg/{{ path }}" alt="">{%- endmacro -%}

{#- Painted full-page opener; the title is part of the picture (static/img/chapters/chNN.jpg, see tools/import_assets.py). -#}
{%- macro chapter(ch, n) -%}
{%- set _y = chapter_title_y.get('%02d' % n) -%}
<div class="page chapter" data-toc="{{ ch.id }}" data-chap="{{ ch.title }}" style="background-image:url('{{ S }}/img/chapters/ch{{ '%02d' % n }}.jpg')">
  {% if _y is not none and ch.opener %}<div class="ct" style="top:{{ _y }}pt"><div class="l1">{{ ch.opener[0] }}</div><div class="l2">{{ ch.opener[1] }}</div><div class="rule"><i></i><b></b><i></i></div></div>{% endif %}
</div>
{%- endmacro -%}

{%- macro page_art(path, x, y, w) -%}
<img class="art" style="left:{{ x }}mm;top:{{ y }}mm;width:{{ w }}mm" src="{{ S }}/svg/{{ path }}" alt="">
{%- endmacro -%}

{%- macro pill(level) -%}<span class="pill pill-{{ level }}">{{ level }}</span>{%- endmacro -%}
{%- macro medallion(icon) -%}<span class="ic med"><img src="{{ S }}/svg/category_icons/{{ icon }}_icon_medallion.svg" alt=""></span>{%- endmacro -%}

{#- The reference moon sprites: phase 1 (new) .. 12 (full).  best = full, good = gibbous, average = thin crescent. -#}
{%- macro mi(n, cls="") -%}<img class="mi {{ cls }}" src="{{ S }}/img/moons/phase_{{ '%02d' % n }}.png" alt="">{%- endmacro -%}
{%- set LV = {"best": 12, "good": 8, "average": 3} -%}
{%- macro lv(level, cls="") -%}{{ mi(LV[level], cls) }}{%- endmacro -%}

{%- macro legend() -%}
<div class="legend">
  <span>{{ lv("best") }} Best</span><span>{{ lv("good") }} Good</span><span>{{ lv("average") }} Average</span>
</div>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title_en }} {{ year }} — {{ person.name }}</title>
<meta name="author" content="Astro Diva Pratihast">
<link rel="stylesheet" href="{{ S }}/css/report.css">
</head>
<body>
{{ art.defs|safe }}

<template id="wm-tpl"><div class="wm">{{ art.watermark|safe }}</div></template>
<template id="page-shell"><div class="page bg-page">{{ running("") }}{{ footer() }}</div></template>

{# ============================================================ COVER #}
<div class="page cover bg-cover">
  {#- the painted cover carries a placeholder name/date: cover it and write the customer's own -#}
  {%- set _l = person.name|length -%}
  {%- set _sz = 28 if _l <= 14 else (24 if _l <= 20 else (20 if _l <= 26 else (17 if _l <= 34 else 14))) -%}
  <div class="id">
    <div class="for">FOR</div>
    <div class="nm"><i></i><svg viewBox="-10 -10 20 20"><path d="M0,-10 C1.2,-3 3,-1.2 10,0 C3,1.2 1.2,3 0,10 C-1.2,3 -3,1.2 -10,0 C-3,-1.2 -1.2,-3 0,-10Z" fill="#dcc080"/></svg><b style="--nm:{{ _sz }}pt">{{ person.name }}</b><svg viewBox="-10 -10 20 20"><path d="M0,-10 C1.2,-3 3,-1.2 10,0 C3,1.2 1.2,3 0,10 C-1.2,3 -3,1.2 -10,0 C-3,-1.2 -1.2,-3 0,-10Z" fill="#dcc080"/></svg><i></i></div>
    <div class="dob">{{ person.dob|replace("/", "-") }}</div>
  </div>
</div>

{# ============================================================ DISCLAIMER #}
<section class="flow" data-running="Disclaimer">
  <template class="flow-first">
    {{ sec_head(None, "Terms of use", ["Disclaimer"], emblem_img("decorative_elements/disclaimer_seal_emblem.svg")) }}
    <div class="pre"></div>
  </template>
  <div class="flow-source">
    {% for p in fixed.disclaimer %}
    {% if loop.last %}<p class="lede" data-nosplit style="margin-top:6pt">{{ p }}</p>{% else %}<p>{{ p }}</p>{% endif %}
    {% endfor %}
  </div>
</section>

{# ============================================================ BEFORE YOU BEGIN #}
<div class="page bg-page" data-fit="Before You Begin">
  {{ running("Before You Begin") }}
  <div class="plain-head">
    <div class="eyebrow">{{ fixed.before_you_begin_eyebrow or "A note before your journey" }}</div>
    <h1>Before You <em>Begin</em></h1>
    <span class="hr-short"></span>
  </div>
  <div class="content serif-body" style="top:196pt;font-size:calc(11pt * var(--fit,1));line-height:calc(17.5pt * var(--fit,1))" data-max-bottom="762">
    {% for p in fixed.before_you_begin %}<p>{{ p }}</p>{% endfor %}
    <p class="sig-r"><em class="script">{{ fixed.letter_signature }}</em></p>
  </div>
  {{ footer() }}
</div>

{# ============================================================ CONTENTS #}
<div class="page bg-page">
  {{ running("Contents") }}
  <div class="toc-head">
    <div class="label">{{ title_hi }}<span>{{ year }}</span></div>
    <h1>Contents</h1>
    <div class="for"><span class="caps">Prepared for</span><b>{{ person.name }}</b></div>
  </div>
  <div class="toc">
    {% for ch in chapter_list %}
    <div class="row">
      <div class="n">{{ ch.num }}</div>
      <div class="m">{{ mi([loop.index0 + 1, 12]|min) }}</div>
      <div class="t">{{ ch.title }}</div>
      <div class="s">{{ ch.subtitle }}</div>
      <div class="p" data-toc-ref="{{ ch.id }}"></div>
    </div>
    {% endfor %}
  </div>
  {{ footer() }}
</div>

{# ============================================================ CHAPTER 01 #}
{{ chapter(chapters.mirror, 1) }}

<div class="page bg-page profile">
  {{ running(chapters.mirror.title) }}
  <div class="stack">
    <div class="who">
      <div class="eyebrow">Cosmic identity{% if chart.tatva %} · {{ chart.tatva }}{% endif %}</div>
      <h1>{{ person.name }}</h1>
      <div class="born">{{ born_line }}</div>
    </div>
    <div class="chips"><span>Asc · {{ asc|title }}</span>{% if sun %}<span>Sun · {{ sun|title }}</span>{% endif %}</div>
    <div class="cards3">
      <div class="card sign-card"><div class="glyph">{{ art.glyph_moon|safe }}</div><div class="eyebrow">Moon sign</div><b>{{ moon|title }}</b></div>
      <div class="card sign-card">{% if sun %}<div class="glyph">{{ art.glyph_sun|safe }}</div><div class="eyebrow">Sun sign</div><b>{{ sun|title }}</b>{% endif %}</div>
      <div class="card sign-card"><div class="glyph">{{ art.glyph_asc|safe }}</div><div class="eyebrow">Ascendant</div><b>{{ asc|title }}</b></div>
    </div>
    <div class="facts">
      {% for f in profile_rows %}<div class="fact"><div class="k">{{ f.label }}</div><div class="v">{{ f.value }}</div></div>{% endfor %}
    </div>
    <div class="card const-card">
      <div class="eyebrow">Moon sign</div>
      <b>{{ moon|title }}</b>
    </div>
  </div>
  {{ footer() }}
</div>

<section class="flow" data-running="{{ chapters.mirror.title }}">
  <template class="flow-first">
    {{ sec_head(chapters.mirror.num, "Personality & true-self analysis", [chapters.mirror.title], emblem_img("decorative_elements/mirror_section_emblem.svg")) }}
    <div class="pre"><p class="lede" style="margin:0 0 14pt">{{ mirror.lede }}</p></div>
  </template>
  <div class="flow-source">
    {% for p in mirror.paras %}<p{% if loop.first %} class="has-dc"{% endif %}>{{ p|rich(dropcap=loop.first) }}</p>{% endfor %}
  </div>
</section>

{# ============================================================ CHAPTER 02 #}
{{ chapter(chapters.shape, 2) }}

<section class="flow" data-running="{{ chapters.shape.title }}">
  <template class="flow-first">
    {{ sec_head(chapters.shape.num, "Yearly overview", chapters.shape.opener, emblem_img("decorative_elements/vesica_section_emblem.svg")) }}
    <div class="pre"></div>
  </template>
  <div class="flow-source">
    {% for p in shape.paras %}<p{% if loop.first %} class="has-dc"{% endif %}>{{ p|rich(dropcap=loop.first) }}</p>{% endfor %}
  </div>
</section>

{# ============================================================ CHAPTER 03 — MONTHS #}
{{ chapter(chapters.monthly, 3) }}

<div class="page bg-page glance" data-fit="Year at a glance">
  {{ running("Your " ~ year ~ " at a Glance") }}
  {{ sec_head(chapters.monthly.num, "Year overview", ["Your " ~ year ~ " at a Glance"], art.moon_emblems[11]) }}
  <div class="label1 eyebrow">Monthly status across the eight areas of life</div>
  <div class="grid">
    <div class="hd"><span></span>{% for m in months %}<span>{{ m.abbr }}</span>{% endfor %}</div>
    {% for r in glance_rows %}
    <div class="r"><b>{{ r.label }}</b>{% for lvl in r.levels %}<i>{{ lv(lvl) }}</i>{% endfor %}</div>
    {% endfor %}
  </div>
  {{ legend() }}
  <div class="label2 eyebrow">Jupiter’s movement through your year</div>
  <div class="jbar">
    {% for b in jupiter.bar %}<div class="seg" style="left:{{ b.left }}%;width:{{ b.width }}%"><span class="lbl" style="top:{{ b.row * 9 }}pt">{{ b.label }}</span><i></i></div>{% endfor %}
    <div class="mm">{% for m in months %}<span>{{ m.abbr }}</span>{% endfor %}</div>
  </div>
  <div class="card note-card" style="top:584pt">
    <div class="eyebrow">How to read this chapter</div>
    <p>Each month opens with the phase of the year, followed by your status map across the eight areas of life and a detailed forecast for every area. Status labels are exactly as assessed for your chart: Best, Good and Average.</p>
  </div>
  {{ footer() }}
</div>

{% for m in months %}
<div class="page month-open bg-page">
  {%- set mv = moon_months[loop.index0] %}
  {{ running(title_en ~ " " ~ year) }}
  <div class="count eyebrow">Month {{ m.num }} of 12</div>
  <div class="name">{{ m.name }}</div>
  {{ art.month_ring|safe }}
  <img class="bigmoon" src="{{ S }}/img/moons/month_{{ m.num }}.png" alt="">
  {% for d in mv.discs %}<img class="dm{% if d.flip %} fl{% endif %}{% if d.key %} key{% endif %}" style="left:{{ d.x }}pt;top:{{ d.y }}pt" src="{{ S }}/img/moons/phase_{{ '%02d' % d.sprite }}.png" alt="">{% endfor %}
  <div class="pcards">
    {% for c in mv.cards %}<div class="pcard"><span class="pc pc-{{ c.phase }}"></span><div class="lb">{{ c.label }}</div>{% if c.date %}<div class="dt">{{ c.date }}</div><div class="tm">{{ c.time }}</div>{% else %}<div class="dt none">&mdash;</div><div class="tm">none this month</div>{% endif %}</div>{% endfor %}
  </div>
  <div class="strip"><i class="ln l"></i><i class="ln r"></i>
    {% for k in range(1, 13) %}<span class="{% if k == m.index %}cur{% endif %}" style="left:{{ 123.7 + 29.25 * (k - 1) - 99 }}pt">{{ mi(k) }}</span>{% endfor %}
  </div>
  {{ footer() }}
</div>

{%- set nb = m.areas|selectattr("level","equalto","best")|list -%}
{%- set ng = m.areas|selectattr("level","equalto","good")|list -%}
{%- set na = m.areas|selectattr("level","equalto","average")|list -%}
<div class="page bg-page status">
  {{ running(m.name ~ " · " ~ title_en) }}
  <div class="status-head">
    <div class="eyebrow">{{ m.name }} · Future lens · {{ year }}</div>
    <h1>Your Status Map</h1>
    <div class="sign"><span class="eyebrow">Moon sign · {{ moon|title }}</span></div>
  </div>
  <div class="card status-sum">
    <div class="mo">{{ m.abbr }}</div>
    <div class="cap">Month at a glance</div>
    <div class="moons">{% for a in nb + ng + na %}{{ lv(a.level) }}{% endfor %}</div>
    <div class="cnt"><span><b>{{ nb|length }}</b>Best</span><span><b>{{ ng|length }}</b>Good</span><span><b>{{ na|length }}</b>Average</span></div>
  </div>
  <div class="slide-list">
    {% for a in m.areas %}
    <div class="it">{{ medallion(a.icon) }}<b>{{ a.label }}</b><u>{{ a.level }}</u>
      <div class="trk"><div class="ln"></div><span class="lb a">Average</span><span class="lb g">Good</span><span class="lb b">Best</span>
        <span class="kn" style="left:{{ {'average': 1.5, 'good': 50, 'best': 98.5}[a.level] }}%">{{ lv(a.level) }}</span></div>
    </div>
    {% endfor %}
  </div>
  <div class="lean">
    <div>{{ lv("best", "hd") }}<h4>Lean in</h4><p>Areas running at their strongest this month.</p><div class="l">{% for a in nb %}<span>{{ a.label }}</span>{% else %}<span>—</span>{% endfor %}</div></div>
    <div class="dark">{{ lv("average", "hd") }}<h4>Move with care</h4><p>Areas that ask for patience and steady effort.</p><div class="l">{% for a in na %}<span>{{ a.label }}</span>{% else %}<span>—</span>{% endfor %}</div></div>
  </div>
  {{ footer() }}
</div>

<section class="flow" data-running="{{ m.name }} · {{ title_en }}">
  <template class="flow-first">
    {{ sec_head(m.num, "Detailed forecast", [m.name ~ " " ~ year], art.moon_emblems[loop.index0]) }}
    <div class="pre"></div>
  </template>
  <div class="flow-source">
    {% for a in m.areas %}
    {% set cid = m.num ~ "-" ~ a.key %}
    <div class="area-head cd-head cd" data-keep data-head data-card="{{ cid }}" data-card-title="{{ a.label }}">{{ medallion(a.icon) }}<b>{{ a.label }}</b>{{ pill(a.level) }}</div>
    {% for p in a.paras %}<p class="cd{% if loop.last %} cd-end{% endif %}" data-card="{{ cid }}" data-card-title="{{ a.label }}">{{ p|rich }}</p>{% endfor %}
    {% endfor %}
  </div>
</section>
{% endfor %}

{# ============================================================ CHAPTER 03 continued — YEARLY #}
{{ chapter(chapters.summary, 4) }}

{% for y in yearly %}
<section class="flow" data-running="{{ y.title }}">
  <template class="flow-first">
    {{ sec_head(y.num, "Yearly forecast", [y.title], emblem_img("category_icons/" ~ y.icon ~ "_section_emblem.svg")) }}
    <div class="pre"></div>
  </template>
  <div class="flow-source">
    {% for p in y.intro %}<p{% if loop.first %} class="has-dc"{% endif %}>{{ p|rich(dropcap=loop.first) }}</p>{% endfor %}
    {% for s in y.sections %}
    {% if s.title %}<h3 class="yr-h" data-keep>{{ s.title }}</h3>{% endif %}
    {% for p in s.body %}<p{% if loop.last %} class="yr-last"{% endif %}>{{ p|rich }}</p>{% endfor %}
    {% endfor %}
  </div>
</section>
{% endfor %}

{# ============================================================ CHAPTER 04 — TRANSITS #}
{{ chapter(chapters.transits, 5) }}

<section class="flow" data-running="Jupiter’s Transit Impact on You">
  <template class="flow-first">
    {{ sec_head("01", "Planetary transit", ["Jupiter’s Transit", "Impact on You"], emblem_img("planets/jupiter_section_emblem.svg")) }}
    <div class="pre"><div style="margin:6pt 0 20pt 0">{{ jupiter.timeline|safe }}</div></div>
  </template>
  <div class="flow-source">
    {% for p in jupiter.periods %}
    {% set cid = "jup-" ~ loop.index %}
    <div class="period-head cd-head cd" data-keep data-head data-card="{{ cid }}" data-card-title="{{ p.house_label }}">
      <span class="pl"><img src="{{ S }}/svg/planets/jupiter_planet_small_row_marker.svg" alt=""></span>
      <span><b>{{ p.house_label }}</b>{% if p.dates %}<span class="d">{{ p.dates }}</span>{% endif %}{% if p.in_label %}<span class="s">{{ p.in_label }}</span>{% endif %}</span>
    </div>
    {% for t in p.body %}<p class="cd{% if loop.last %} cd-end{% endif %}" data-card="{{ cid }}" data-card-title="{{ p.house_label }}">{{ t|rich }}</p>{% endfor %}
    {% endfor %}
    {% for t in jupiter.closing %}<p class="closing{% if loop.first %} sep{% endif %}">{{ t|rich }}</p>{% endfor %}
  </div>
</section>

{% for t in [("02", "Saturn", saturn, "planets/saturn_section_emblem.svg"), ("03", "Rahu-Ketu", rahu, "planets/rahu_ketu_section_emblem.svg")] %}
<section class="flow" data-running="{{ t[1] }}’s Transit Impact on You">
  <template class="flow-first">
    {{ sec_head(t[0], "Planetary transit", [t[1] ~ "’s Transit", "Impact on You"], emblem_img(t[3])) }}
    <div class="pre"><div style="margin:6pt 0 14pt 0">
      {% for c in t[2].charts %}
      <div class="houses{% if t[2].charts|length > 1 %} small{% endif %}">
        {{ c.svg|safe }}
        <div>
          <div class="eyebrow">{{ c.title }}</div>
          <div class="strip">{% for h in range(1, 13) %}<i{% if h in c.active %} class="on"{% endif %}>{{ h }}</i>{% endfor %}</div>
          <div class="cap">{{ c.caption }}</div>
        </div>
      </div>
      {% endfor %}
    </div></div>
  </template>
  <div class="flow-source">
    {% for p in t[2].paras %}<p{% if loop.first %} class="has-dc"{% endif %}>{{ p|rich(dropcap=loop.first) }}</p>{% endfor %}
  </div>
</section>
{% endfor %}

{% for pm in planet_months %}
<section class="flow" data-running="{{ pm.label }}’s Transit Impact on You">
  <template class="flow-first">
    {{ sec_head(pm.num, "Planetary transit", [pm.label ~ "’s Transit", "Impact on You"], emblem_img("planets/" ~ pm.key ~ "_section_emblem.svg")) }}
    <div class="pre"><div class="sub-eyebrow" style="margin:2pt 0 10pt">{{ pm.label }} · Month by month</div></div>
  </template>
  <div class="flow-source">
    {% for e in pm.months %}
    <div class="pm-head" data-keep>{{ mi(e.index, "sm") }}<b>{{ e.name }}</b><span>Month {{ e.num }}</span></div>
    {% for t in e.body %}<p data-nosplit class="pm-p">{{ t|rich }}</p>{% endfor %}
    {% endfor %}
  </div>
</section>
{% endfor %}

{# ============================================================ CHAPTER 05 — ENERGIES #}
{{ chapter(chapters.energies, 6) }}

{% for e in [("01", "Working for you", ["Your Lucky Dates,", "Colours & Day"], lucky, "Lucky", "decorative_elements/lucky_star_section_emblem.svg", "Your Lucky Dates, Colours & Day"),
             ("02", "Working against you", ["Dates, Colours & Day", "to Handle with Care"], unlucky, "Unlucky", "decorative_elements/eclipse_section_emblem.svg", "Dates, Colours & Day to Handle with Care")] %}
<div class="page bg-page" data-fit="{{ e[6] }}">
  {{ running(e[6]) }}
  {{ sec_head(e[0], e[1], e[2], emblem_img(e[5])) }}
  <div class="energy">
    <div class="card"><div class="viz">{{ e[3].calendar|safe }}</div>
      <div class="txt" data-within=".card"><div class="eyebrow">{{ e[4] }} dates</div><b>{{ e[3].dates_label }}</b><p>{{ e[3].dates_text }}</p></div></div>
    <div class="card"><div class="viz">{{ e[3].swatches|safe }}</div>
      <div class="txt" data-within=".card"><div class="eyebrow">{{ e[4] }} colours</div><b>{{ e[3].colours_label }}</b><p>{{ e[3].colours_text }}</p></div></div>
    <div class="card"><div class="viz">{{ e[3].week|safe }}</div>
      <div class="txt" data-within=".card"><div class="eyebrow">{{ e[4] }} day</div><b>{{ e[3].day }}</b><p>{{ e[3].day_text }}</p></div></div>
  </div>
  {{ footer() }}
</div>
{% endfor %}

<div class="page bg-page" data-fit="Rudraksha">
  {{ running("Rudraksha") }}
  {{ sec_head("03", "Sacred protection", ["Rudraksha"], rudraksha.emblem) }}
  <div class="rud-hero">
    <div class="beads n{{ rudraksha.beads|length }}">{% for b in rudraksha.beads %}<img src="{{ S }}/img/rudraksha/{{ b }}.png" alt="{{ b }} mukhi">{% endfor %}</div>
    <div class="eyebrow">Recommended for you</div><b>{{ rudraksha.label }}</b>
  </div>
  <p class="rud-quote" data-max-bottom="452">{{ rudraksha.description }}</p>
  <div class="rud-cols" data-max-bottom="762">
    <div>
      <h3>When You Must Remove Rudraksha</h3>
      <ul class="stars-list">{% for t in fixed.rudraksha_remove %}<li>{{ t }}</li>{% endfor %}</ul>
      {% if fixed.rudraksha_remove_sub %}<ul class="dash-list">{% for t in fixed.rudraksha_remove_sub %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
    </div>
    <div>
      <h3>Procedure Of Wearing Rudraksha (First Time)</h3>
      {% for t in fixed.rudraksha_procedure %}<p>{{ t }}</p>{% endfor %}
    </div>
  </div>
  {{ footer() }}
</div>

<div class="page bg-page" data-fit="Gemstones Report">
  {{ running("Gemstones Report") }}
  {{ sec_head("04", "Stones aligned to your chart", ["Gemstones Report"], gems.emblem) }}
  <div class="gem-label1 eyebrow">Lucky gemstones</div>
  <div class="gem-cards">
    {% for g in gems.lucky %}
    <div class="card gem-card"><img class="gem" src="{{ S }}/img/gems/{{ g.slug }}.png" alt=""><div data-within=".gem-card" data-pad="6"><b>{{ g.name }}</b><p>{{ g.text|mantra }}</p></div></div>
    {% endfor %}
  </div>
  <div class="gem-bottom" data-max-bottom="762">
    {% if gems.unlucky %}
    <div class="gem-avoid-list">
      <div class="eyebrow">Unlucky gemstones</div>
      {% for g in gems.unlucky %}<div class="it"><img class="gem-avoid" src="{{ S }}/img/gems/{{ g.slug }}.png" alt=""><b>{{ g.name }}</b></div>{% endfor %}
    </div>
    {% endif %}
    <div class="gem-process"><div class="eyebrow">Process</div><p>{{ gems.process }}</p></div>
  </div>
  {{ footer() }}
</div>

{# ============================================================ CHAPTER 06 — DO'S AND DON'TS #}
{{ chapter(chapters.dodont, 7) }}

<div class="page bg-page dd-page" data-fit="Do’s">
  {{ running(chapters.dodont.title) }}
  {{ sec_head(chapters.dodont.num, "Your framework for " ~ year ~ " · Embrace", [chapters.dodont.opener[0]], "") }}
  <div class="dd one" data-max-bottom="762">
    <div><div class="eyebrow">Embrace · Do’s</div>
      {% for t in dos %}<div class="it"><img src="{{ S }}/svg/decorative_elements/check_icon.svg" alt="">{{ t }}</div>{% endfor %}</div>
  </div>
  {{ footer() }}
</div>

<div class="page bg-page dd-page" data-fit="Don’ts">
  {{ running(chapters.dodont.title) }}
  {{ sec_head(chapters.dodont.num, "Your framework for " ~ year ~ " · Avoid", [chapters.dodont.opener[1]|replace("& ", "")], "") }}
  <div class="dd one" data-max-bottom="762">
    <div><div class="eyebrow off">Avoid · Don’ts</div>
      {% for t in donts %}<div class="it"><img src="{{ S }}/svg/decorative_elements/cross_icon.svg" alt="">{{ t }}</div>{% endfor %}</div>
  </div>
  {{ footer() }}
</div>

{# ============================================================ CHAPTER 07 — REMEDIES #}
{{ chapter(chapters.remedies, 8) }}

<div class="page bg-page" data-fit="{{ chapters.remedies.title }}">
  {{ running(chapters.remedies.title) }}
  {{ sec_head(chapters.remedies.num, "Sacred practice", chapters.remedies.opener, emblem_img("spiritual_icons/lotus_star_section_emblem.svg")) }}
  <p class="lede rem-lede" data-max-bottom="318" data-own-fit>{{ remedies.intro }}</p>
  <div class="rem-cards">
    {% for r in remedies["items"] %}
    <div class="card rem-card"><div class="txt" data-within=".rem-card"><div class="eyebrow">Remedy {{ r.num }}</div><p>{{ r.text }}</p></div></div>
    {% endfor %}
  </div>
  {{ footer() }}
</div>

{# ============================================================ CHAPTER 08 — LIGHT #}
{{ chapter(chapters.light, 9) }}

<div class="page bg-page affirm" data-fit="Affirmation">
  {{ running(chapters.light.title) }}
  <div class="box" data-max-bottom="600">
    <div class="eyebrow">Your affirmation for {{ year }}</div>
    <blockquote>{{ affirmation.line }}</blockquote>
    <img class="div" src="{{ S }}/svg/dividers/star_rule_divider_short.svg" alt="">
    <p class="why">{{ affirmation.why }}</p>
  </div>
  {{ footer() }}
</div>

<div class="page bg-page" data-fit="{{ chapters.light.title }}">
  {{ running(chapters.light.title) }}
  {{ sec_head(chapters.light.num, "Practice", [affirmation.ritual.name or "Your Ritual"], affirmation.ritual_emblem) }}
  <div class="ritual" data-max-bottom="762">
    {% for r in affirmation.ritual.rows %}<div class="r"><div class="k">{{ r.label }}</div><div class="v">{{ r.text }}</div></div>{% endfor %}
    <div class="closing">
      <p class="has-dc">{{ affirmation.closing|rich(dropcap=True) }}</p>
      <p class="light">{{ affirmation.light }}</p>
    </div>
  </div>
  {{ footer() }}
</div>

{# ============================================================ CHAPTER 09 — CLOSING #}
<div class="page bg-page" data-toc="closing" data-chap="{{ chapters.closing.title }}" data-fit="{{ chapters.closing.title }}">
  {{ running(chapters.closing.title) }}
  <div class="plain-head">
    <div class="eyebrow">A personal note</div>
    <h1>{{ chapters.closing.opener[0] }}<br><em>{{ chapters.closing.opener[1] }}</em></h1>
    <span class="hr-short"></span>
  </div>
  <div class="letter-body" data-max-bottom="762">
    {% for p in fixed.letter %}<p>{{ p }}</p>{% endfor %}
    <p class="thanks">{{ fixed.letter_thanks }}</p>
    <p class="signoff">{{ fixed.letter_signoff }}</p>
    <p class="sig">{{ fixed.letter_signature }}</p>
  </div>
  {{ footer() }}
</div>

{# ============================================================ CONSULTATION #}
<div class="page bg-page" data-toc="consult" data-chap="Personal Consultation" data-fit="Personal Consultation">
  {{ running("Personal Consultation") }}
  {{ sec_head(chapters.consult.num, "A private invitation", ["Still Unsure? Book Your", "Personal Consultation"], emblem_img("decorative_elements/consultation_star_section_emblem.svg")) }}
  <div class="consult-body" data-max-bottom="512">
    {% for p in fixed.consultation %}<p>{{ p }}</p>{% endfor %}
  </div>
  <div class="card consult-card">
    <div class="eyebrow">One-to-one astrology · Personal guidance</div>
    <h2>A private reading with<em class="script">Diva Pratihast</em></h2>
    <a class="btn" href="{{ fixed.consultation_url }}">Book consultation now on WhatsApp</a>
    <div class="contact"><a href="{{ fixed.consultation_url }}">{{ contact.whatsapp_label }}</a><a href="https://{{ contact.website }}">{{ contact.website }}</a></div>
  </div>
  {{ footer() }}
</div>

{# ============================================================ BACK COVER #}
<div class="page back bg-page" data-fit="About">
  {{ running("About Astro Diva") }}
  <div class="plain-head">
    <div class="eyebrow">About the astrologer</div>
    <h1>Astro Diva Pratihast</h1>
    <span class="hr-short"></span>
  </div>
  <div class="about" data-max-bottom="640">{% for p in back_cover %}<p>{{ p }}</p>{% endfor %}</div>
  <div class="tail2">
    <img class="div" src="{{ S }}/svg/dividers/star_rule_divider_short.svg" alt="">
    <div class="tag">{{ back_cover_tagline }}</div>
    <div class="caps">{{ contact.website }} · {{ contact.phone }}</div>
  </div>
  {{ footer() }}
</div>
<script src="{{ S }}/js/paginate.js"></script>
</body>
</html>
