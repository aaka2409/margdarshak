# Copy to .env and fill in.  Never commit .env.
REPORT_YEAR=2027
ALLOW_SAMPLE_CONTENT=0
OUTPUT_DIR=generated_reports

# Chart lookup (VedicAstroAPI).  Without it, each request must carry its own "chart".
VEDIC_ASTRO_API_KEY=

# Protect the HTTP endpoint: callers send this in the X-Api-Token header.  Leave empty only on a private network.
API_TOKEN=
MAX_PARALLEL_REPORTS=2

# E-mail (Gmail needs an app password, not your login password)




SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Order database (optional - leave DB_HOST empty to skip bookkeeping)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_QUEUE_TABLE=love_report_queue
DB_ORDERS_TABLE=checkout_orders
